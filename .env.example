# Base URL of the affiliate-backend API, including the /api prefix. Inlined at build time.
#   Android emulator:  http://10.0.2.2:4000/api
#   Physical phone:    http://<your-computer-LAN-IP>:4000/api   (same Wi-Fi as the computer)
#   APK builds:        set in eas.json (must be the deployed https:// backend; release builds refuse plain http)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
